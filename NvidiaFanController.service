[Unit]
Description=Nvidia Fan Controller
After=nvidia-persistenced.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/sbin/NvidiaFanController.py
ExecStopPost=-/usr/bin/python3 /usr/local/sbin/NvidiaFanController.py --auto
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
